# 系统杂项
.DS_Store
Thumbs.db
[Dd]esktop.ini

# 编辑器临时文件；共享编辑器配置不整体忽略
*.swp
*.swo
*~

# 本地环境与凭证文件；脱敏示例可以版本管理
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 防止误放仓库根目录的私人数据进入 Git；不屏蔽同名源码或测试夹具
/private/
/data/
/backups/

# 临时和打包内容应存放在 README 约定的仓外目录
/tmp/
/temp/
/logs/
/test-results/
/build/
/dist/
/dists/
/mumu_lbcut_tool_dev/
/mumu_lbcut_tool_tmp/
/mumu_lbcut_tool_dists/
.scratch/

# Python 缓存与字节码
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# 本地调试与临时采样文件
scripts/*.png
scripts/*.jpg
scripts/*.xml
scripts/seg1_timeline/

# 技术栈确定后按实际工具补充依赖与缓存规则
